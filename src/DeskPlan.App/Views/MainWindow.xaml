<Window x:Class="DeskPlan.App.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="DeskPlan · 桌面计划" Width="360" Height="510" MinWidth="320" MinHeight="420" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
  ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" UseLayoutRounding="True">
  <Grid>
  <Border x:Name="Shell" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Surface}">
    <Grid Margin="16,12,16,8">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="HeaderDown" MouseMove="HeaderMove" MouseLeftButtonUp="HeaderUp">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="DESKPLAN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="0,0,0,4"/>
          <TextBlock Text="{Binding DayTitle}" FontSize="23" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding DateLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
          <Button x:Name="ModeButton" Content="⇄" FontSize="19" Style="{StaticResource QuietButton}" ToolTip="{Binding ModeHint}" AutomationProperties.Name="切换桌面与悬浮模式" Click="SwitchMode"/>
          <Button Content="▦" FontSize="18" Style="{StaticResource QuietButton}" ToolTip="日 / 周 / 月回顾" AutomationProperties.Name="历史回顾" Click="OpenReview"/>
          <Button Content="⋯" FontSize="20" Style="{StaticResource QuietButton}" ToolTip="设置与备份" AutomationProperties.Name="设置" Click="OpenSettings"/>
          <Button Content="×" FontSize="17" Style="{StaticResource QuietButton}" ToolTip="关闭组件" AutomationProperties.Name="关闭组件" Click="CloseWidget"/>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10" Margin="0,14,0,12">
        <StackPanel><DockPanel><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding CompletionLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}" FontSize="11"/></DockPanel>
          <ProgressBar Value="{Binding Average, Mode=OneWay}" Margin="0,9,0,7"/>
          <DockPanel><TextBlock Text="{Binding AverageLabel}" FontSize="11" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding ModeName}" FontSize="10" HorizontalAlignment="Right" Foreground="{DynamicResource Muted}"/></DockPanel>
        </StackPanel>
      </Border>
      <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Content="今天" Click="Today" Padding="9,5" Margin="0,0,5,0"/><Button Grid.Column="1" Content="明天" Click="Tomorrow" Padding="9,5" Margin="0,0,5,0"/>
        <DatePicker Grid.Column="2" SelectedDate="{Binding SelectedDate}" DisplayDateStart="1900-01-01" DisplayDateEnd="9998-12-31" SelectedDateFormat="Short" ToolTip="选择计划日期"/>
      </Grid>
      <Grid Grid.Row="3">
        <ScrollViewer x:Name="TaskScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl x:Name="TaskItems" ItemsSource="{Binding Tasks}">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border x:Name="TaskCard" CornerRadius="8" Background="{DynamicResource Card}" BorderThickness="1" Padding="9,6" Margin="0,0,3,6" AllowDrop="True" Drop="TaskDrop">
                <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></Style.Triggers>
                </Style></Border.Style>
                <StackPanel>
                  <DockPanel Margin="0,0,0,1">
                    <TextBlock Text="⠿" FontSize="11" Cursor="SizeAll" ToolTip="拖动调整顺序" Margin="0,0,6,0" Foreground="{DynamicResource Muted}" PreviewMouseLeftButtonDown="GripDown" MouseMove="GripMove"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Percentage}" FontSize="11" Margin="8,0,0,0">
                      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource Accent}"/><Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                      </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium">
                      <TextBlock.ToolTip><ToolTip MaxWidth="340"><StackPanel>
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11"/>
                      </StackPanel></ToolTip></TextBlock.ToolTip>
                      <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="TextDecorations" Value="Strikethrough"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/></DataTrigger>
                      </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </DockPanel>
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="编辑" Style="{StaticResource QuietButton}" Padding="4,0" FontSize="10" Click="EditTask" AutomationProperties.Name="编辑任务"/>
                    <TextBlock FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding TimeLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Status, Mode=OneWay}"/>
                    </TextBlock>
                  </DockPanel>
                  <Slider Height="18" Value="{Binding Progress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Status}" AutomationProperties.Name="{Binding Title, StringFormat={}{0}进度}" PreviewMouseLeftButtonUp="SliderReleased" LostKeyboardFocus="SliderBlurred"/>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <StackPanel Visibility="{Binding EmptyVisibility}" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,0,15">
          <TextBlock Text="☀" FontSize="30" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
          <TextBlock Text="{Binding EmptyTitle}" FontSize="12" HorizontalAlignment="Center"/>
          <TextBlock Text="{Binding EmptySubtitle}" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="4" Margin="0,7,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid Margin="0,0,7,0">
            <TextBox x:Name="QuickTitle" ToolTip="输入计划后按 Enter；右侧 + 可设置时间与重复" AutomationProperties.Name="快速添加计划" KeyDown="QuickAddKey"/>
            <TextBlock Text="写下一项计划，按 Enter 添加" FontSize="11" Foreground="{DynamicResource Muted}" Margin="10,0" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=QuickTitle}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <Button Grid.Column="1" Content="＋" FontSize="19" Padding="9,3" Style="{StaticResource PrimaryButton}" ToolTip="添加完整计划" Click="AddTask" AutomationProperties.Name="添加完整计划"/>
        </Grid>
        <Button Content="{Binding OverdueLabel}" Click="OpenOverdue" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" FontSize="10" Foreground="{DynamicResource Muted}" Padding="0,7"/>
      </StackPanel>
      <Grid Grid.Row="5"><TextBlock Text="{Binding SaveStatus}" FontSize="9" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,0,92,0"/>
        <Button x:Name="ReturnDesktopButton" Content="放回桌面" Click="ReturnToDesktop" Visibility="{Binding ReturnDesktopVisibility}" HorizontalAlignment="Right" Margin="0,0,22,0" Padding="4,1" FontSize="10" Style="{StaticResource QuietButton}" ToolTip="恢复桌面壁纸层显示"/>
      </Grid>
    </Grid>
  </Border>
    <!-- Edges exclude corner hit areas; corners take precedence without covering content controls. -->
    <Thumb x:Name="ResizeLeft" Tag="Left" Width="6" Margin="0,16,0,16" HorizontalAlignment="Left" Cursor="SizeWE" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从左边调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone"/>
    <Thumb x:Name="ResizeRight" Tag="Right" Width="6" Margin="0,16,0,16" HorizontalAlignment="Right" Cursor="SizeWE" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从右边调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone"/>
    <Thumb x:Name="ResizeTop" Tag="Top" Height="6" Margin="16,0,16,0" VerticalAlignment="Top" Cursor="SizeNS" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从上边调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone"/>
    <Thumb x:Name="ResizeBottom" Tag="Bottom" Height="6" Margin="16,0,16,0" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从下边调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone"/>
    <Thumb x:Name="ResizeTopLeft" Tag="Top, Left" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从左上角调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone"/>
    <Thumb x:Name="ResizeTopRight" Tag="Top, Right" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从右上角调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone"/>
    <Thumb x:Name="ResizeBottomLeft" Tag="Bottom, Left" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从左下角调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone"/>
    <Thumb x:Name="ResizeBottomRight" Tag="Bottom, Right" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{StaticResource ResizeHandle}" AutomationProperties.Name="从右下角调整大小" DragStarted="ResizeStarted" DragDelta="ResizeDelta" DragCompleted="ResizeDone">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="#01000000">
        <Path Data="M 3,12 L 12,3 M 8,12 L 12,8" Stroke="{DynamicResource Muted}" StrokeThickness="1" Opacity="0.6" IsHitTestVisible="False"/>
      </Grid></ControlTemplate></Thumb.Template>
    </Thumb>
  </Grid>
</Window>
